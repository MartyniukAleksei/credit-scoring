# виртуальное окружение
venv/
.venv/

# Python кэши
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.coverage

# данные — не коммитим сами файлы
data/raw/*
data/processed/*
!data/raw/*.dvc
!data/processed/*.dvc
!data/raw/.gitkeep
!data/processed/.gitkeep

# models — lgbm_pipeline.joblib is committed too so Railway (deploys
# straight from the GitHub source, no dvc pull step) has it in the build context
models/*
!models/*.dvc
!models/lgbm_pipeline.joblib

# jupyter
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store

.env